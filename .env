# -------------------------------------------------------------------------
# Общие настройки
# -------------------------------------------------------------------------

# Часовой пояс
TIME_ZONE=Europe/Moscow

# Базовый домен
#
# Требования для маршрутизации по доменным именам:
# 1. Запущенный глобальный сервис Traefik
# 2. Wildcard-запись DNS *.meteoforge.local на IP-адрес хост-сервера
BASE_DOMAIN=meteoforge.local


# -------------------------------------------------------------------------
# Приложение
# -------------------------------------------------------------------------

# Порты: панель управления
APPLICATION_DASHBOARD_HOST_PORT=3320
APPLICATION_DASHBOARD_CONTAINER_PORT=8000

# Порты: программный интерфейс
APPLICATION_INTERFACE_HOST_PORT=3321
APPLICATION_INTERFACE_CONTAINER_PORT=8000

# Домены: панель управления
APPLICATION_DASHBOARD_DOMAIN=stormcast.${BASE_DOMAIN}

# Домены: программный интерфейс
APPLICATION_INTERFACE_DOMAIN=interface.stormcast.${BASE_DOMAIN}

# Основные настройки
APPLICATION_DEBUG_MODE=True
APPLICATION_SECRET_KEY=ambiguous-step-whenever-pliable-educated
APPLICATION_ALLOWED_HOSTS=*

# Учётные данные
APPLICATION_DEFAULT_USER=admin
APPLICATION_DEFAULT_PASSWORD=12HowSoonIsNow
APPLICATION_DEFAULT_EMAIL=admin@stormcast.local

# Опциональные возможности
APPLICATION_FEATURE_USE_REDIS=False
APPLICATION_FEATURE_ENABLE_REALTIME=False
APPLICATION_FEATURE_ENABLE_API=True


# -------------------------------------------------------------------------
# База данных
# -------------------------------------------------------------------------

# Порты: программный интерфейс
DATABASE_INTERFACE_HOST_PORT=3323
DATABASE_INTERFACE_CONTAINER_PORT=5432

# Адрес базы данных внутри сети контейнеров
DATABASE_INTERFACE_HOST=database

# Учётные данные
DATABASE_DEFAULT_NAME=messages
DATABASE_DEFAULT_USER=admin
DATABASE_DEFAULT_PASSWORD=cesspool-procreate-brook-saloon-cramp

# Строка соединения для внешних клиентов и асинхронных библиотек.
# Django использует отдельные параметры выше.
DATABASE_INTERFACE_DSN=postgresql+asyncpg://${DATABASE_DEFAULT_USER}:${DATABASE_DEFAULT_PASSWORD}@database:${DATABASE_INTERFACE_CONTAINER_PORT}/${DATABASE_DEFAULT_NAME}


# -------------------------------------------------------------------------
# Менеджер базы данных
# -------------------------------------------------------------------------

# Порты: панель управления
DATABASE_MANAGER_DASHBOARD_HOST_PORT=3322
DATABASE_MANAGER_DASHBOARD_CONTAINER_PORT=80

# Домены: панель управления
DATABASE_MANAGER_DASHBOARD_DOMAIN=database.${BASE_DOMAIN}

# Учётные данные
DATABASE_MANAGER_DEFAULT_EMAIL=admin@${BASE_DOMAIN}
DATABASE_MANAGER_DEFAULT_PASSWORD=cesspool-procreate-brook-saloon-cramp


# -------------------------------------------------------------------------
# Шина событий
# -------------------------------------------------------------------------

# Порты: программный интерфейс
EVENT_BUS_INTERFACE_HOST_PORT=3325
EVENT_BUS_INTERFACE_CONTAINER_PORT=6379

# Логический индекс базы данных
EVENT_BUS_INDEX=0

# URI соединения
EVENT_BUS_DSN=redis://event-bus:${EVENT_BUS_INTERFACE_CONTAINER_PORT}/${EVENT_BUS_INDEX}


# -------------------------------------------------------------------------
# Объектное хранилище
# -------------------------------------------------------------------------

# Порты: панель управления
OBJECT_STORAGE_DASHBOARD_HOST_PORT=3326
OBJECT_STORAGE_DASHBOARD_CONTAINER_PORT=9001

# Порты: программный интерфейс
OBJECT_STORAGE_INTERFACE_HOST_PORT=3327
OBJECT_STORAGE_INTERFACE_CONTAINER_PORT=9000

# Домены: панель управления
OBJECT_STORAGE_DASHBOARD_DOMAIN=storage.stormcast.${BASE_DOMAIN}

# Домены: программный интерфейс
OBJECT_STORAGE_INTERFACE_DOMAIN=interface.storage.stormcast.${BASE_DOMAIN}

# Учётные данные
OBJECT_STORAGE_BUCKET=stormcast
OBJECT_STORAGE_DEFAULT_USER=admin
OBJECT_STORAGE_DEFAULT_PASSWORD=janitor-remedial-flashing-segment-stick

# Параметры соединения
OBJECT_STORAGE_ADDRESS=minio:${OBJECT_STORAGE_INTERFACE_CONTAINER_PORT}
OBJECT_STORAGE_USE_SSL=False


# -------------------------------------------------------------------------
# Почтовый сервер
# -------------------------------------------------------------------------
# В среде разработки используется Mailpit.
# В производственной среде требуется настоящий SMTP-сервер.

# Порты: панель управления
MAIL_SERVER_DASHBOARD_HOST_PORT=3328
MAIL_SERVER_DASHBOARD_CONTAINER_PORT=8025

# Порты: программный интерфейс
MAIL_SERVER_INTERFACE_HOST_PORT=3329
MAIL_SERVER_INTERFACE_CONTAINER_PORT=1025

# Домены: панель управления
MAIL_SERVER_DASHBOARD_DOMAIN=mail.stormcast.${BASE_DOMAIN}

# Параметры соединения
MAIL_SERVER_HOST=mail-server
MAIL_SERVER_USE_TLS=False
MAIL_SERVER_DEFAULT_EMAIL=oper-ugms@yugmeteo.donpac.ru
