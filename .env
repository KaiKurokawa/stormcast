# =========================================================================
# Общие настройки
# =========================================================================
#
# Структура имён:
# - двойное подчёркивание разделяет уровни дерева;
# - одинарное подчёркивание соединяет слова внутри одного уровня.
#
# После имени сервиса следуют компоненты и смысловые группы.
# Компоненты (DASHBOARD, INTERFACE) используются, когда сервис предоставляет
# несколько самостоятельных интерфейсов. Остальные группы (PORT, ROUTING,
# DATABASE, CONNECTION и другие) описывают назначение настроек.
#
# Пример:
# APPLICATION__INTERFACE__PORT__PUBLISHED
# └─────────┘  └───────┘  └──┘  └───────┘
#   сервис     компонент группа уточнение

# Имя проекта
#
# Используется как общий префикс в доменных именах и других настройках,
# которые должны однозначно идентифицировать проект.
COMMON__PROJECT_NAME=stormcast

# Базовый домен
#
# От него формируются домены сервисов и их отдельных интерфейсов.
#
# Для маршрутизации по доменным именам необходимы:
# 1. Запущенный глобальный сервис Traefik.
# 2. DNS-записи, направляющие используемые домены на IP-адрес хост-сервера.
#
# Важно: wildcard-запись *.meteoforge.local обычно покрывает только один
# уровень имён. Для вложенных доменов, например interface.stormcast.meteoforge.local,
# необходимо предусмотреть соответствующие DNS-записи.
COMMON__PROJECT__DOMAIN_BASE=meteoforge.local

# Домен проекта
#
# Формируется из имени проекта и базового домена.
# Используется как основное доменное пространство проекта, внутри которого
# формируются домены сервисов и их функциональных интерфейсов.
COMMON__PROJECT__DOMAIN=${COMMON__PROJECT_NAME}.${COMMON__PROJECT__DOMAIN_BASE}

# Префикс опубликованных портов проекта
#
# Первые три цифры обозначают проект в общем манифесте портов.
# Последняя цифра обозначает конкретную точку доступа.
#
# Полный порт формируется добавлением однозначного номера к префиксу:
#   332 + 0 = 3320
#   332 + 1 = 3321
#
# Распределение точек доступа:
#   0 — приложение: панель управления
#   1 — приложение: программный интерфейс
#   2 — менеджер базы данных: панель управления
#   3 — база данных: программный интерфейс
#   4 — резерв
#   5 — шина событий: программный интерфейс
#   6 — объектное хранилище: панель управления
#   7 — объектное хранилище: программный интерфейс
#   8 — почтовый сервер: панель управления
#   9 — почтовый сервер: SMTP-интерфейс
#
# Порты сервисов формируются на основании этого префикса.
# Для переноса проекта в другой диапазон достаточно изменить его значение.
COMMON__PORT__PREFIX=332

# Общий часовой пояс
#
# Используется контейнерами, которым требуется согласованное представление
# времени. Каждый сервис получает значение через собственную конфигурацию.
COMMON__TIME_ZONE=Europe/Moscow


# =========================================================================
# Приложение (Stormcast)
# =========================================================================
#
# Основное приложение для работы с метеорологическими сводками.
# Предоставляет веб-панель управления и отдельный программный интерфейс.


# -------------------------------------------------------------------------
# Панель управления
# -------------------------------------------------------------------------

# Порты
APPLICATION__DASHBOARD__PORT__PUBLISHED=${COMMON__PORT__PREFIX}0
APPLICATION__DASHBOARD__PORT__CONTAINER=8000

# Маршрутизация
#
# DOMAIN — основной адрес панели управления.
# ROLE_DOMAIN — дополнительный адрес, обозначающий функциональную роль.
# Оба имени должны быть включены в правила маршрутизации Traefik.
APPLICATION__DASHBOARD__ROUTING__DOMAIN=${COMMON__PROJECT__DOMAIN}
APPLICATION__DASHBOARD__ROUTING__ROLE_DOMAIN=application.${COMMON__PROJECT__DOMAIN}

# Учётные данные
#
# Начальная учётная запись приложения для входа в панель управления.
# Используется при первоначальной настройке приложения.
APPLICATION__DASHBOARD__CREDENTIALS__DEFAULT__USERNAME=admin
APPLICATION__DASHBOARD__CREDENTIALS__DEFAULT__PASSWORD=12HowSoonIsNow
APPLICATION__DASHBOARD__CREDENTIALS__DEFAULT__EMAIL=admin@${COMMON__PROJECT__DOMAIN}


# -------------------------------------------------------------------------
# Программный интерфейс
# -------------------------------------------------------------------------
#
# API приложения. Доступен независимо от веб-панели управления.

# Порты
APPLICATION__INTERFACE__PORT__PUBLISHED=${COMMON__PORT__PREFIX}1
APPLICATION__INTERFACE__PORT__CONTAINER=8000

# Маршрутизация
#
# DOMAIN — основной адрес программного интерфейса.
# ROLE_DOMAIN — дополнительный адрес, обозначающий его назначение.
APPLICATION__INTERFACE__ROUTING__DOMAIN=interface.${COMMON__PROJECT__DOMAIN}
APPLICATION__INTERFACE__ROUTING__ROLE_DOMAIN=interface.application.${COMMON__PROJECT__DOMAIN}

# Состояние интерфейса
#
# Позволяет включать или отключать API независимо от остальных компонентов.
APPLICATION__INTERFACE__ENABLED=True

# Пагинация
#
# Количество записей, возвращаемых API на одной странице.
APPLICATION__INTERFACE__PAGINATION__PAGE_SIZE=50


# -------------------------------------------------------------------------
# Общие настройки
# -------------------------------------------------------------------------

# Режим отладки
#
# В производственной среде должен быть отключён.
APPLICATION__GENERAL__DEBUG__ENABLED=True

# Безопасность
#
# SECRET_KEY используется Django для криптографических операций.
# ALLOWED_HOSTS определяет имена хостов, которым разрешено обращаться
# к приложению. Звёздочка разрешает любые имена и подходит только
# для контролируемой среды разработки.
APPLICATION__GENERAL__SECURITY__SECRET_KEY=12HowSoonIsNow
APPLICATION__GENERAL__SECURITY__ALLOWED_HOSTS=*

# Доверенные источники CSRF
#
# Список допустимых источников запросов, проходящих CSRF-проверку.
# Используются полные адреса с указанием схемы http или https.
# Список разделяется запятыми.
APPLICATION__GENERAL__SECURITY__CSRF_TRUSTED_ORIGINS=http://${APPLICATION__DASHBOARD__ROUTING__DOMAIN},https://${APPLICATION__DASHBOARD__ROUTING__DOMAIN},http://${APPLICATION__DASHBOARD__ROUTING__ROLE_DOMAIN},https://${APPLICATION__DASHBOARD__ROUTING__ROLE_DOMAIN},http://${APPLICATION__INTERFACE__ROUTING__DOMAIN},https://${APPLICATION__INTERFACE__ROUTING__DOMAIN},http://${APPLICATION__INTERFACE__ROUTING__ROLE_DOMAIN},https://${APPLICATION__INTERFACE__ROUTING__ROLE_DOMAIN}

# Перенаправление на HTTPS
#
# В разработке отключено. В производственной среде за HTTPS-прокси
# должно быть включено после настройки TLS на стороне Traefik.
APPLICATION__GENERAL__SECURITY__SSL_REDIRECT=False

# HTTP Strict Transport Security (HSTS)
#
# Срок действия требования использовать HTTPS, в секундах.
# Применяется только при отключённом режиме отладки.
APPLICATION__GENERAL__SECURITY__HSTS__SECONDS=31536000

# Дополнительные возможности
#
# Управление интеграцией с Redis и обработкой событий в реальном времени.
APPLICATION__GENERAL__FEATURES__REDIS__ENABLED=False
APPLICATION__GENERAL__FEATURES__REALTIME__ENABLED=False

# Протоколирование
#
# Уровень журналирования приложения.
# Допустимые значения: DEBUG, INFO, WARNING, ERROR, CRITICAL.
APPLICATION__GENERAL__LOGGING__LEVEL=DEBUG


# =========================================================================
# База данных (PostgreSQL)
# =========================================================================
#
# Основная реляционная база данных приложения.


# -------------------------------------------------------------------------
# Сетевой интерфейс
# -------------------------------------------------------------------------

# Имя сервиса в сети Compose.
# Используется другими контейнерами для подключения к PostgreSQL.
DATABASE__INTERFACE__HOSTNAME=database

# Порты
#
# PUBLISHED — порт, опубликованный на хосте.
# CONTAINER — порт PostgreSQL внутри контейнера.
DATABASE__INTERFACE__PORT__PUBLISHED=${COMMON__PORT__PREFIX}3
DATABASE__INTERFACE__PORT__CONTAINER=5432


# -------------------------------------------------------------------------
# Параметры базы данных
# -------------------------------------------------------------------------

# Имя базы данных
#
# Это именно имя базы PostgreSQL, а не имя схемы.
# Значение public в данном случае будет именем отдельной базы данных.
DATABASE__GENERAL__NAME=public

# Учётные данные
#
# Начальная административная учётная запись PostgreSQL.
# В официальном образе значение POSTGRES_USER используется для создания
# начальной роли с правами суперпользователя.
DATABASE__CREDENTIALS__DEFAULT__USERNAME=admin
DATABASE__CREDENTIALS__DEFAULT__PASSWORD=12HowSoonIsNow


# -------------------------------------------------------------------------
# Подключение
# -------------------------------------------------------------------------

# Строка подключения
#
# DSN для клиентов внутри сети Compose, в том числе асинхронных библиотек
# с драйвером asyncpg. Использует внутреннее имя сервиса и порт контейнера.
#
# Для внешних клиентов необходим другой адрес подключения:
# IP-адрес хоста и опубликованный порт.
DATABASE__CONNECTION__DSN=postgresql+asyncpg://${DATABASE__CREDENTIALS__DEFAULT__USERNAME}:${DATABASE__CREDENTIALS__DEFAULT__PASSWORD}@${DATABASE__INTERFACE__HOSTNAME}:${DATABASE__INTERFACE__PORT__CONTAINER}/${DATABASE__GENERAL__NAME}

# Максимальный срок жизни соединения
#
# Время в секундах, в течение которого Django может повторно использовать
# соединение с PostgreSQL. Ноль означает закрытие соединения после запроса.
# Для ASGI рекомендуется оставить нулевое значение.
DATABASE__CONNECTION__MAX_AGE=0


# =========================================================================
# Архиватор базы данных
# =========================================================================
#
# Сервис автоматического резервного копирования PostgreSQL.


# -------------------------------------------------------------------------
# Хранилище
# -------------------------------------------------------------------------

# Каталог архивов
#
# Путь внутри контейнера архиватора. Для сохранения резервных копий
# между перезапусками он должен быть связан с постоянным хранилищем.
DATABASE_ARCHIVER__STORAGE__ARTIFACTS_PATH=/data/artifacts


# -------------------------------------------------------------------------
# Расписание
# -------------------------------------------------------------------------

# Расписание резервного копирования
#
# Формат cron. Текущее значение соответствует ежедневному запуску в 03:00.
# Время выполнения определяется часовым поясом контейнера.
DATABASE_ARCHIVER__SCHEDULE__CRON=0 3 * * *

# Срок хранения резервных копий
#
# Количество дней, после которого архивы могут удаляться.
DATABASE_ARCHIVER__SCHEDULE__RETENTION_DAYS=30


# =========================================================================
# Менеджер базы данных (pgAdmin)
# =========================================================================
#
# Отдельный сервис для администрирования PostgreSQL через веб-интерфейс.
# Не является частью самого сервера базы данных.


# -------------------------------------------------------------------------
# Панель управления
# -------------------------------------------------------------------------

# Порты
DATABASE_MANAGER__DASHBOARD__PORT__PUBLISHED=${COMMON__PORT__PREFIX}2
DATABASE_MANAGER__DASHBOARD__PORT__CONTAINER=80

# Маршрутизация
#
# DOMAIN — основной адрес панели управления.
# ROLE_DOMAIN — адрес, обозначающий административное назначение сервиса.
DATABASE_MANAGER__DASHBOARD__ROUTING__DOMAIN=pgadmin.${COMMON__PROJECT__DOMAIN}
DATABASE_MANAGER__DASHBOARD__ROUTING__ROLE_DOMAIN=manager.database.${COMMON__PROJECT__DOMAIN}

# Учётные данные
#
# Начальная учётная запись администратора pgAdmin.
DATABASE_MANAGER__DASHBOARD__CREDENTIALS__DEFAULT__EMAIL=admin@${COMMON__PROJECT__DOMAIN}
DATABASE_MANAGER__DASHBOARD__CREDENTIALS__DEFAULT__PASSWORD=12HowSoonIsNow


# -------------------------------------------------------------------------
# Сетевой интерфейс
# -------------------------------------------------------------------------

# Имя сервиса в сети Compose.
DATABASE_MANAGER__INTERFACE__HOSTNAME=database_manager


# =========================================================================
# Шина событий (Redis)
# =========================================================================
#
# Redis используется для обмена данными между компонентами приложения.


# -------------------------------------------------------------------------
# Сетевой интерфейс
# -------------------------------------------------------------------------

# Имя сервиса в сети Compose.
EVENT_BUS__INTERFACE__HOSTNAME=event-bus

# Порты
EVENT_BUS__INTERFACE__PORT__PUBLISHED=${COMMON__PORT__PREFIX}5
EVENT_BUS__INTERFACE__PORT__CONTAINER=6379


# -------------------------------------------------------------------------
# Параметры базы данных
# -------------------------------------------------------------------------

# Индекс логической базы Redis.
EVENT_BUS__DATABASE__INDEX=0


# -------------------------------------------------------------------------
# Подключение
# -------------------------------------------------------------------------

# Строка подключения
#
# DSN формируется из сетевого имени сервиса, внутреннего порта
# и индекса логической базы Redis.
EVENT_BUS__CONNECTION__DSN=redis://${EVENT_BUS__INTERFACE__HOSTNAME}:${EVENT_BUS__INTERFACE__PORT__CONTAINER}/${EVENT_BUS__DATABASE__INDEX}


# =========================================================================
# Объектное хранилище (Silo)
# =========================================================================
#
# MinIO (Silo) предоставляет S3-совместимый программный интерфейс
# для работы с объектами и отдельную веб-панель управления.


# -------------------------------------------------------------------------
# Панель управления
# -------------------------------------------------------------------------

# Порты
OBJECT_STORAGE__DASHBOARD__PORT__PUBLISHED=${COMMON__PORT__PREFIX}6
OBJECT_STORAGE__DASHBOARD__PORT__CONTAINER=9001

# Маршрутизация
#
# DOMAIN — основной адрес веб-панели MinIO (Silo).
# ROLE_DOMAIN — дополнительный адрес, обозначающий административное
# назначение интерфейса.
OBJECT_STORAGE__DASHBOARD__ROUTING__DOMAIN=silo.${COMMON__PROJECT__DOMAIN}
OBJECT_STORAGE__DASHBOARD__ROUTING__ROLE_DOMAIN=manager.storage.${COMMON__PROJECT__DOMAIN}


# -------------------------------------------------------------------------
# Программный интерфейс
# -------------------------------------------------------------------------

# Порты
OBJECT_STORAGE__INTERFACE__PORT__PUBLISHED=${COMMON__PORT__PREFIX}7
OBJECT_STORAGE__INTERFACE__PORT__CONTAINER=9000

# Сетевой адрес
#
# Имя сервиса в сети Compose, по которому приложение обращается к MinIO (Silo).
OBJECT_STORAGE__INTERFACE__HOSTNAME=object-storage

# Endpoint
#
# Адрес программного интерфейса без схемы протокола, учётных данных
# и дополнительных параметров подключения.
OBJECT_STORAGE__INTERFACE__ENDPOINT=${OBJECT_STORAGE__INTERFACE__HOSTNAME}:${OBJECT_STORAGE__INTERFACE__PORT__CONTAINER}

# Маршрутизация
#
# DOMAIN — основной адрес S3-совместимого интерфейса.
# ROLE_DOMAIN — дополнительный адрес, обозначающий его функциональное
# назначение в структуре доменов проекта.
OBJECT_STORAGE__INTERFACE__ROUTING__DOMAIN=silo.${COMMON__PROJECT__DOMAIN}
OBJECT_STORAGE__INTERFACE__ROUTING__ROLE_DOMAIN=interface.storage.${COMMON__PROJECT__DOMAIN}

# Параметры защищённого соединения
#
# Определяют использование TLS при подключении приложения к MinIO.
OBJECT_STORAGE__INTERFACE__CONNECTION__TLS__ENABLED=False


# -------------------------------------------------------------------------
# Общие настройки
# -------------------------------------------------------------------------

# Объектный контейнер
#
# Имя bucket, в котором приложение хранит объекты.
OBJECT_STORAGE__BUCKET__NAME=${COMMON__PROJECT_NAME}

# Учётные данные
#
# Начальная учётная запись MinIO для административного доступа.
OBJECT_STORAGE__CREDENTIALS__DEFAULT__USERNAME=admin
OBJECT_STORAGE__CREDENTIALS__DEFAULT__PASSWORD=12HowSoonIsNow


# =========================================================================
# Почтовый сервер (Mailpit / SMTP)
# =========================================================================
#
# В среде разработки используется Mailpit.
# Он предоставляет веб-панель для просмотра сообщений и отдельный SMTP-интерфейс
# для их приёма от приложения.
#
# В производственной среде используется SMTP-сервер организации,
# например почтовый сервер или SMTP-релей, интегрированный с Active Directory.
# Для перехода между средами меняются адрес сервера, порт и параметры
# аутентификации и шифрования.


# -------------------------------------------------------------------------
# Панель управления
# -------------------------------------------------------------------------

# Порты
MAIL_SERVER__DASHBOARD__PORT__PUBLISHED=${COMMON__PORT__PREFIX}8
MAIL_SERVER__DASHBOARD__PORT__CONTAINER=8025

# Маршрутизация
#
# DOMAIN — основной адрес веб-панели Mailpit.
# ROLE_DOMAIN — дополнительный адрес, обозначающий административную роль.
MAIL_SERVER__DASHBOARD__ROUTING__DOMAIN=mailpit.${COMMON__PROJECT__DOMAIN}
MAIL_SERVER__DASHBOARD__ROUTING__ROLE_DOMAIN=manager.mail.${COMMON__PROJECT__DOMAIN}


# -------------------------------------------------------------------------
# Программный интерфейс (SMTP)
# -------------------------------------------------------------------------

# Сетевой адрес
#
# В разработке — имя сервиса Mailpit в сети Compose.
# В производственной среде — DNS-имя SMTP-сервера организации.
MAIL_SERVER__INTERFACE__HOSTNAME=mail-server

# Порты
#
# PUBLISHED — порт SMTP, опубликованный на хосте.
# CONTAINER — порт SMTP-сервера, к которому подключается приложение.
# Для Mailpit используется 1025. В производственной среде значение
# определяется настройками SMTP-сервера.
MAIL_SERVER__INTERFACE__PORT__PUBLISHED=${COMMON__PORT__PREFIX}9
MAIL_SERVER__INTERFACE__PORT__CONTAINER=1025

# Учётные данные
#
# В локальной среде Mailpit обычно не требует аутентификации.
# Для производственного SMTP-сервера указываются учётные данные,
# предоставленные почтовой службой организации.
MAIL_SERVER__INTERFACE__CREDENTIALS__USERNAME=
MAIL_SERVER__INTERFACE__CREDENTIALS__PASSWORD=

# Шифрование соединения
#
# TLS — явное переключение соединения на защищённый канал, обычно через STARTTLS.
# SSL — защищённое соединение с самого начала сеанса.
# Одновременно включать оба режима нельзя.
#
# В локальной среде Mailpit оба режима отключены.
# В производственной среде параметры определяются настройками SMTP-сервера.
MAIL_SERVER__INTERFACE__CONNECTION__TLS__ENABLED=False
MAIL_SERVER__INTERFACE__CONNECTION__SSL__ENABLED=False


# -------------------------------------------------------------------------
# Общие параметры соединения
# -------------------------------------------------------------------------

# Почтовый backend Django
#
# Для Mailpit и производственного SMTP-сервера используется один и тот же
# SMTP backend. Различаются только адрес сервера, порт, аутентификация и TLS.
MAIL_SERVER__CONNECTION__BACKEND=django.core.mail.backends.smtp.EmailBackend

# Количество повторных попыток отправки
#
# Используется прикладной логикой отправки почты. Сам SMTP backend Django
# автоматически повторные попытки по этому параметру не выполняет.
MAIL_SERVER__CONNECTION__RETRY__MAX_ATTEMPTS=3


# -------------------------------------------------------------------------
# Идентификация отправителя
# -------------------------------------------------------------------------

# Адрес отправителя по умолчанию
#
# Используется приложением при формировании исходящих сообщений.
MAIL_SERVER__IDENTITY__DEFAULT_SENDER=oper-ugms@yugmeteo.donpac.ru
