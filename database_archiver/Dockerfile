# -------------------------------------------------------------------------
# Сервис архивации баз данных
# -------------------------------------------------------------------------
# Данный образ предназначен для создания логических резервных копий баз данных.
# Он работает на базе легкого дистрибутива Alpine и использует планировщик
# Supercronic для точного соблюдения графиков резервного копирования.

FROM alpine:3.24


# -------------------------------------------------------------------------
# Системные компоненты
# -------------------------------------------------------------------------
# Для работы службы необходимы инструменты связи с базой и сжатия данных:
# - mariadb-client: обеспечивает выгрузку данных (дамп)
# - gzip:           выполняет сжатие архивов для экономии места
# - findutils:      позволяет находить и удалять старые архивы
# - bash / curl:    нужны для работы сценариев и загрузки планировщика

RUN apk add --no-cache \
    mariadb-client \
    gzip \
    findutils \
    bash \
    curl


# -------------------------------------------------------------------------
# Планировщик задач (Supercronic)
# -------------------------------------------------------------------------

ENV URL=https://github.com/aptible/supercronic/releases/download/v0.2.33/supercronic-linux-amd64

RUN --network=host curl -fsSLO "$URL" \
    && chmod +x supercronic-linux-amd64 \
    && mv supercronic-linux-amd64 /usr/local/bin/supercronic


# -------------------------------------------------------------------------
# Инициализация сценариев управления
# -------------------------------------------------------------------------
# Копирование сценария из локального каталога репозитория. Это позволяет
# поддерживать чистоту Dockerfile и удобно редактировать логику запуска.
#
# - entrypoint.sh: готовит таблицу расписания при старте
# - worker.sh:     выполняет непосредственное создание дампа

COPY ./scripts/entrypoint.sh /scripts/entrypoint.sh
COPY ./scripts/worker.sh /usr/local/bin/worker.sh

RUN chmod +x /scripts/entrypoint.sh /usr/local/bin/worker.sh

WORKDIR /scripts

ENTRYPOINT ["/scripts/entrypoint.sh"]
