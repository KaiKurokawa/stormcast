# -------------------------------------------------------------------------
# Нормализация текстовых файлов
# -------------------------------------------------------------------------
# Назначение:
# Определение текстовых форматов и политики перевода строк.
# Все неописанные типы файлов считаются бинарными по умолчанию.


# -------------------------------------------------------------------------
# Текстовые форматы с нормализацией EOL
# -------------------------------------------------------------------------
# Для перечисленных типов файлов применяется:
# - текстовый режим Git
# - нормализация перевода строк в LF

*.php           text eol=lf
*.css           text eol=lf
*.xml           text eol=lf
*.html          text eol=lf
*.htm           text eol=lf
*.js            text eol=lf
*.json          text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
*.sh            text eol=lf
*.txt           text eol=lf
*.env           text eol=lf
*.cnf           text eol=lf
*.py            text eol=lf
*.csv           text eol=lf

# Конфигурация Git
*.gitignore     text eol=lf
*.gitattributes text eol=lf


# -------------------------------------------------------------------------
# Политика для неопределённых форматов
# -------------------------------------------------------------------------
# Все файлы, не попавшие под явное правило выше,
# классифицируются как бинарные без нормализации текста.

* -text
