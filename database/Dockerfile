# -------------------------------------------------------------------------
# СУБД PostgreSQL с расширением pg_uuidv7
# -------------------------------------------------------------------------
# Данный образ расширяет официальный дистрибутив PostgreSQL 17 на базе Alpine.
# Он компилирует и интегрирует C-расширение pg_uuidv7, обеспечивающее нативную,
# высокопроизводительную генерацию упорядоченных по времени идентификаторов
# UUID версии 7 согласно стандарту RFC 9562.

FROM postgres:17-alpine


# -------------------------------------------------------------------------
# Зависимости компиляции и сборка расширения
# -------------------------------------------------------------------------
# Сборка выполняется в рамках одного слоя RUN для уменьшения итогового
# размера образа и удаления инструментов компиляции после установки.
#
# Важно: clang/llvm здесь используются только как альтернативный C-компилятор
# для сборки расширения pg_uuidv7. PostgreSQL JIT (LLVM-based) в этом процессе
# не задействуется напрямую.
#
# Используемые компоненты:
# - git:      загрузка исходного кода расширения pg_uuidv7 из репозитория
# - make:     система сборки расширения PostgreSQL (pgxs / Makefile)
# - gcc:      основной C-компилятор (используется частью toolchain и fallback-сборки)
# - clang21:  альтернативный C-компилятор, используется через переменную CC=clang
#             для сборки расширения
# - llvm21:   зависимости clang toolchain (линковка, bitcode инструменты),
#             требуются пакетом clang в Alpine
# - musl-dev: заголовочные файлы стандартной библиотеки C для Alpine (musl libc)
#
# Поведение сборки:
# - исходники расширения клонируются во временную директорию /tmp
# - выполняется компиляция через pgxs (PostgreSQL extension build system)
# - расширение устанавливается в системные каталоги PostgreSQL
# - временные файлы и build-зависимости удаляются для уменьшения образа

RUN apk add --no-cache --virtual .build-deps \
        git \
        make \
        gcc \
        clang21 \
        llvm21 \
        musl-dev \
    && git clone https://github.com/fboulnois/pg_uuidv7.git /tmp/pg_uuidv7 \
    && cd /tmp/pg_uuidv7 \
    && CC=clang make \
    && make install \
    && rm -rf /tmp/pg_uuidv7 \
    && apk del .build-deps


# -------------------------------------------------------------------------
# Настройки среды выполнения
# -------------------------------------------------------------------------
# Образ наследует стандартную конфигурацию запуска родительского контейнера
# postgres:17-alpine. Расширение будет доступно для инициализации через
# команду `CREATE EXTENSION pg_uuidv7;` сразу после старта инстанса.
