# -------------------------------------------------------------------------
# Базовый образ
# -------------------------------------------------------------------------
# Использование официального образа Python на базе Debian Slim.
# Обеспечивает баланс между размером контейнера и наличием системных библиотек.

FROM python:3.13-slim


# -------------------------------------------------------------------------
# Системные переменные окружения
# -------------------------------------------------------------------------
# Отключение создания файлов .pyc и принудительный сброс буферов вывода.
# Необходимо для корректного отображения логов в реальном времени.

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1


# -------------------------------------------------------------------------
# Системные компоненты и библиотеки
# -------------------------------------------------------------------------
# Установка пакетов, необходимых для работы генератора PDF (WeasyPrint),
# обработки изображений и работы с различными форматами данных.

RUN apt-get update && apt-get install -y --no-install-recommends \
    # Библиотеки для рендеринга PDF (WeasyPrint)
    libcairo2 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libgdk-pixbuf-2.0-0 \
    libffi-dev \
    shared-mime-info \
    # Инструменты и шрифты
    pango1.0-tools \
    fonts-liberation \
    # Библиотеки для работы с изображениями
    zlib1g \
    libjpeg62-turbo \
    libopenjp2-7 \
    # Очистка кэша пакетного менеджера для уменьшения размера слоя
    && rm -rf /var/lib/apt/lists/*


# -------------------------------------------------------------------------
# Рабочий каталог
# -------------------------------------------------------------------------

WORKDIR /codebase


# -------------------------------------------------------------------------
# Зависимости Python
# -------------------------------------------------------------------------
# Копирование и установка зависимостей до монтирования основного кода.
# Позволяет использовать кэширование слоев Docker при неизменном файле requirements.txt.

COPY requirements.txt .

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt


# -------------------------------------------------------------------------
# Исходный код приложения
# -------------------------------------------------------------------------
# Копирование исходных файлов проекта в рабочий каталог контейнера.
# Операция выполняется после установки зависимостей для оптимизации кэширования.

COPY ./codebase /codebase


# -------------------------------------------------------------------------
# Точка входа
# -------------------------------------------------------------------------
# Скрипт инициализации отвечает за ожидание готовности базы данных,
# применение миграций и запуск целевого процесса (Gunicorn или Celery).
# Копируется в образ, так как не изменяется в процессе разработки.

COPY ./scripts/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh


# -------------------------------------------------------------------------
# Непривилегированный пользователь
# -------------------------------------------------------------------------
# Создание системного пользователя для выполнения процессов приложения.
# Ограничение прав запуска снижает риски безопасности.

RUN addgroup --system stormuser \
    && adduser --system --group stormuser


# -------------------------------------------------------------------------
# Права доступа
# -------------------------------------------------------------------------
# Назначение непривилегированного пользователя владельцем рабочего каталога
# и переключение контекста выполнения.

RUN chown -R stormuser:stormuser /codebase

USER stormuser


# -------------------------------------------------------------------------
# Сетевые порты
# -------------------------------------------------------------------------

EXPOSE 8000


# -------------------------------------------------------------------------
# Точка входа
# -------------------------------------------------------------------------

ENTRYPOINT ["/entrypoint.sh"]
